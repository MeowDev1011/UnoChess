{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Public online player profile linked to user UID with nickname, Elo ratings, role, and moderation status (no PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "elo": {
          "type": "number"
        },
        "wins": {
          "type": "number"
        },
        "losses": {
          "type": "number"
        },
        "authType": {
          "type": "string",
          "enum": ["device", "lichess"]
        },
        "lichessUsername": {
          "type": "string",
          "maxLength": 40
        },
        "lichessElo": {
          "type": "number"
        },
        "elos": {
          "type": "object",
          "description": "Elo ratings keyed by time control category (unlimited, bullet, blitz, rapid, classical)."
        },
        "lichessElos": {
          "type": "object",
          "description": "Synced Lichess Elo ratings keyed by bullet, blitz, rapid, classical."
        },
        "role": {
          "type": "string",
          "enum": ["user", "moderator", "founder"]
        },
        "banned": {
          "type": "boolean"
        },
        "suspendedUntilMs": {
          "type": "number"
        },
        "chatMuted": {
          "type": "boolean"
        },
        "mutedUntilMs": {
          "type": "number"
        },
        "warningsCount": {
          "type": "number"
        },
        "sanctionReason": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "nickname",
        "elo",
        "wins",
        "losses",
        "authType",
        "lichessUsername",
        "lichessElo",
        "createdAt",
        "updatedAt"
      ]
    },
    "SystemModerationConfig": {
      "title": "SystemModerationConfig",
      "description": "Platform moderation state tracking the founding first-user moderator and live chat/safety controls.",
      "type": "object",
      "properties": {
        "founderUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "founderNickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "globalSlowModeSec": {
          "type": "number"
        },
        "wordFilterEnabled": {
          "type": "boolean"
        },
        "chatDisabledGlobally": {
          "type": "boolean"
        },
        "broadcastBanner": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "founderUid",
        "founderNickname",
        "globalSlowModeSec",
        "wordFilterEnabled",
        "chatDisabledGlobally",
        "broadcastBanner",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameLookup": {
      "title": "UsernameLookup",
      "description": "Normalized username index mapping lowercase nickname to player UID for moderation and role assignment.",
      "type": "object",
      "properties": {
        "usernameKey": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-\\.]{2,20}$",
          "minLength": 2,
          "maxLength": 20
        },
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["usernameKey", "uid", "nickname", "updatedAt"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Open matchmaking challenge posted by a real player in the online lobby.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "creatorUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "creatorNickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "creatorElo": {
          "type": "number"
        },
        "timeControlId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "timeControlLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "minutes": {
          "type": "number"
        },
        "increment": {
          "type": "number"
        },
        "preferredColor": {
          "type": "string",
          "enum": ["random", "white", "black"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "matched", "cancelled"]
        },
        "matchedMatchId": {
          "type": "string",
          "maxLength": 128
        },
        "opponentUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "creatorUid",
        "creatorNickname",
        "creatorElo",
        "timeControlId",
        "timeControlLabel",
        "minutes",
        "increment",
        "preferredColor",
        "status",
        "matchedMatchId",
        "opponentUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "OnlineMatch": {
      "title": "OnlineMatch",
      "description": "Real-time UnoChess online match synchronized between two players (via lobby or magic invite link).",
