          "type": "string",
          "maxLength": 128
        },
        "targetNickname": {
          "type": "string",
          "maxLength": 40
        },
        "details": {
          "type": "string",
          "maxLength": 300
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "action",
        "actorUid",
        "actorNickname",
        "targetUid",
        "targetNickname",
        "details",
        "createdAtMs",
        "createdAt"
      ]
    },
    "MatchHistoryRecord": {
      "title": "MatchHistoryRecord",
      "description": "Completed match record with compact move snapshots, annotations, and variations stored under a player profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "type": "string",
          "enum": ["bot", "local", "online"]
