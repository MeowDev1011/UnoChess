        "reviewerUid": {
          "type": "string",
          "maxLength": 128
        },
        "reviewerNickname": {
          "type": "string",
          "maxLength": 40
        },
        "reviewerNote": {
          "type": "string",
          "maxLength": 300
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "appellantUid",
        "appellantNickname",
        "sanctionType",
        "reason",
        "status",
        "reviewerUid",
        "reviewerNickname",
        "reviewerNote",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "ModerationLog": {
      "title": "ModerationLog",
      "description": "Immutable audit log entry for every moderation action.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "actorUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
