        },
        "elapsedSeconds": {
          "type": "number"
        },
        "eloDelta": {
          "type": "number"
        },
        "createdAtMs": {
          "type": "number"
        },
        "moves": {
          "type": "array"
        },
        "replayTree": {
          "type": "object"
        },
        "createdAt": {
