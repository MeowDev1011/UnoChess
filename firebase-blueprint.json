      "required": [
        "id",
        "ownerUid",
        "mode",
        "whiteName",
        "blackName",
        "playerFaction",
        "result",
        "outcome",
        "reasonText",
        "timeControlLabel",
        "turnsPlayed",
        "elapsedSeconds",
        "createdAtMs",
        "moves",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/system/{docId}": {
      "schema": { "$ref": "#/entities/SystemModerationConfig" },
      "description": "Global moderation configuration including founding moderator identity and chat safety settings."
    },
    "/usernames/{usernameKey}": {
      "schema": { "$ref": "#/entities/UsernameLookup" },
      "description": "Normalized username index enabling O(1) lookup by nickname for moderation and role management."
    },
    "/players/{uid}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Public player identity (UID + nickname + Elo + W/L record + role & sanction status)."
    },
    "/players/{uid}/matches/{recordId}": {
      "schema": { "$ref": "#/entities/MatchHistoryRecord" },
      "description": "Completed match history records for replay, annotation, and export."
    },
    "/challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/Challenge" },
      "description": "Real-time open lobby challenges created and accepted by human players."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/OnlineMatch" },
      "description": "Authoritative real-time state for active online matches and magic invite links."
    },
    "/matches/{matchId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MatchChatMessage" },
      "description": "Real-time in-match chat messages synchronized between players."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ModerationReport" },
      "description": "Submitted user reports for behavior, chat abuse, and game bugs."
    },
    "/appeals/{appealId}": {
      "schema": { "$ref": "#/entities/ModerationAppeal" },
      "description": "Submitted user appeals for moderation sanctions."
    },
    "/moderationLogs/{logId}": {
      "schema": { "$ref": "#/entities/ModerationLog" },
      "description": "Immutable audit trail of moderation actions."
    }
  }
}
