      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "inviteType": {
          "type": "string",
          "enum": ["lobby", "magic_link"]
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "active", "finished"]
        },
        "hostUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "hostNickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "hostElo": {
          "type": "number"
        },
        "guestUid": {
          "type": "string",
          "maxLength": 128
        },
        "guestNickname": {
          "type": "string",
          "maxLength": 20
        },
        "guestElo": {
          "type": "number"
        },
        "timeControlId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "timeControlLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "minutes": {
          "type": "number"
        },
        "increment": {
          "type": "number"
        },
        "p1Uid": {
          "type": "string",
          "maxLength": 128
        },
        "p2Uid": {
          "type": "string",
          "maxLength": 128
        },
        "p1Faction": {
          "type": "string",
          "enum": ["white", "black"]
        },
        "activePlayer": {
          "type": "string",
          "enum": ["p1", "p2"]
        },
        "p1TimeMs": {
          "type": "number"
        },
        "p2TimeMs": {
          "type": "number"
        },
        "stateVersion": {
          "type": "number"
        },
        "turnsPlayed": {
          "type": "number"
        },
        "boardFlat": {
          "type": "array"
        },
        "drawPile": {
          "type": "array"
        },
        "discardPile": {
          "type": "array"
        },
        "capturedWhitePieces": {
          "type": "array"
        },
        "capturedBlackPieces": {
          "type": "array"
        },
        "exiledPieces": {
          "type": "array"
        },
        "enPassantTarget": {
          "type": "object"
        },
        "currentCard": {
          "type": "object"
        },
        "cardFaceDown": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "maxLength": 40
        },
        "movesRemaining": {
          "type": "number"
        },
        "skipOpponentTurns": {
          "type": "number"
        },
        "wildTeleportPending": {
          "type": "boolean"
        },
        "plus2Remaining": {
          "type": "number"
        },
        "plus4Remaining": {
          "type": "number"
        },
        "pendingWildPieceType": {
          "type": "string",
          "maxLength": 16
        },
        "pendingPromotion": {
          "type": "object"
        },
        "bannerKey": {
          "type": "string",
          "maxLength": 80
        },
        "bannerParams": {
          "type": "object"
        },
        "winnerUid": {
          "type": "string",
          "maxLength": 128
        },
        "winReasonKey": {
          "type": "string",
          "maxLength": 80
        },
        "eloDelta": {
          "type": "number"
        },
        "lastChainColor": {
          "type": "string",
          "enum": ["", "red", "blue", "green", "yellow"]
        },
        "lastChainBy": {
          "type": "string",
          "enum": ["", "p1", "p2"]
        },
        "isFirstMoveOfTurn": {
          "type": "boolean"
        },
        "moveHistory": {
          "type": "array"
        },
        "lastDuelText": {
          "type": "string",
          "maxLength": 160
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "inviteType",
        "status",
        "hostUid",
        "hostNickname",
        "hostElo",
        "guestUid",
        "guestNickname",
        "guestElo",
        "timeControlId",
        "timeControlLabel",
        "minutes",
        "increment",
        "p1Uid",
        "p2Uid",
        "p1Faction",
        "activePlayer",
        "p1TimeMs",
        "p2TimeMs",
        "stateVersion",
        "turnsPlayed",
        "boardFlat",
        "drawPile",
        "discardPile",
        "capturedWhitePieces",
        "capturedBlackPieces",
        "exiledPieces",
        "cardFaceDown",
        "phase",
        "movesRemaining",
        "skipOpponentTurns",
        "wildTeleportPending",
        "plus2Remaining",
        "plus4Remaining",
        "pendingWildPieceType",
        "bannerKey",
        "winnerUid",
        "winReasonKey",
        "eloDelta",
        "lastChainColor",
        "lastChainBy",
        "isFirstMoveOfTurn",
        "moveHistory",
        "lastDuelText",
        "createdAt",
        "updatedAt"
      ]
    },
    "MatchChatMessage": {
      "title": "MatchChatMessage",
      "description": "Real-time chat message sent inside an online UnoChess match.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "matchId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "senderUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "senderNickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "moderator", "founder"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "type": "string",
          "enum": ["text", "system", "moderated"]
        },
        "deleted": {
          "type": "boolean"
        },
        "deletedBy": {
          "type": "string",
          "maxLength": 128
        },
        "flagged": {
          "type": "boolean"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "matchId",
        "senderUid",
        "senderNickname",
        "senderRole",
        "text",
        "kind",
        "deleted",
        "deletedBy",
        "flagged",
        "createdAtMs",
        "createdAt"
      ]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "User report for inappropriate behavior, abusive chat, or game bugs.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "reporterUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "reporterNickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "category": {
          "type": "string",
          "enum": ["behavior", "chat", "bug"]
        },
        "targetUid": {
          "type": "string",
          "maxLength": 128
        },
        "targetNickname": {
          "type": "string",
          "maxLength": 40
        },
        "matchId": {
          "type": "string",
          "maxLength": 128
        },
        "messageId": {
          "type": "string",
          "maxLength": 128
        },
        "messageExcerpt": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_review", "resolved", "dismissed"]
        },
        "resolutionNote": {
          "type": "string",
          "maxLength": 300
        },
        "handledByUid": {
          "type": "string",
          "maxLength": 128
        },
        "handledByNickname": {
          "type": "string",
          "maxLength": 40
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "reporterUid",
        "reporterNickname",
        "category",
        "targetUid",
        "targetNickname",
        "matchId",
        "messageId",
        "messageExcerpt",
        "description",
        "status",
        "resolutionNote",
        "handledByUid",
        "handledByNickname",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "ModerationAppeal": {
      "title": "ModerationAppeal",
      "description": "User appeal against a mute, warning, suspension, or ban.",
