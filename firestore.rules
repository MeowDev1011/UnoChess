rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Reusable Hardened Primitives ----------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameKey(key) {
      return key is string && key.size() >= 2 && key.size() <= 20 && key.matches('^[a-z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp;
    }

    function isGuaranteedModeratorUid(uid, data) {
      return uid == 'lichess_gatochess89'
        || (
          'authType' in data
          && data.authType == 'lichess'
          && 'lichessUsername' in data
          && data.lichessUsername is string
          && data.lichessUsername.lower() == 'gatochess89'
        );
    }

    // ---------- Validation Blueprints ----------
    function isValidEloMap(m) {
      return m is map
        && m.keys().hasAll(['unlimited', 'bullet', 'blitz', 'rapid', 'classical'])
        && m.keys().hasOnly(['unlimited', 'bullet', 'blitz', 'rapid', 'classical'])
        && m.unlimited is number && m.unlimited >= 100 && m.unlimited <= 4000
        && m.bullet is number && m.bullet >= 100 && m.bullet <= 4000
        && m.blitz is number && m.blitz >= 100 && m.blitz <= 4000
        && m.rapid is number && m.rapid >= 100 && m.rapid <= 4000
        && m.classical is number && m.classical >= 100 && m.classical <= 4000;
    }

    function isValidLichessEloMap(m) {
      return m is map
        && m.keys().hasAll(['bullet', 'blitz', 'rapid', 'classical'])
        && m.keys().hasOnly(['bullet', 'blitz', 'rapid', 'classical'])
        && m.bullet is number && m.bullet >= 0 && m.bullet <= 4000
        && m.blitz is number && m.blitz >= 0 && m.blitz <= 4000
        && m.rapid is number && m.rapid >= 0 && m.rapid <= 4000
        && m.classical is number && m.classical >= 0 && m.classical <= 4000;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll([
          'uid', 'nickname', 'elo', 'wins', 'losses',
          'authType', 'lichessUsername', 'lichessElo',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'nickname', 'elo', 'wins', 'losses',
          'authType', 'lichessUsername', 'lichessElo',
          'elos', 'lichessElos',
          'role', 'banned', 'suspendedUntilMs',
          'chatMuted', 'mutedUntilMs', 'warningsCount', 'sanctionReason',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 20
        && data.elo is number && data.elo >= 100 && data.elo <= 4000
        && data.wins is number && data.wins >= 0 && data.wins <= 100000
        && data.losses is number && data.losses >= 0 && data.losses <= 100000
        && data.authType in ['device', 'lichess']
        && data.lichessUsername is string && data.lichessUsername.size() <= 40
        && data.lichessElo is number && data.lichessElo >= 0 && data.lichessElo <= 4000
        && (!('elos' in data) || isValidEloMap(data.elos))
        && (!('lichessElos' in data) || isValidLichessEloMap(data.lichessElos))
        && (!('role' in data) || data.role in ['user', 'moderator', 'founder'])
        && (!('banned' in data) || data.banned is bool)
        && (!('suspendedUntilMs' in data) || (data.suspendedUntilMs is number && data.suspendedUntilMs >= 0))
        && (!('chatMuted' in data) || data.chatMuted is bool)
        && (!('mutedUntilMs' in data) || (data.mutedUntilMs is number && data.mutedUntilMs >= 0))
        && (!('warningsCount' in data) || (data.warningsCount is number && data.warningsCount >= 0 && data.warningsCount <= 1000))
        && (!('sanctionReason' in data) || (data.sanctionReason is string && data.sanctionReason.size() <= 200))
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidSystemModeration(data) {
      return data.keys().hasAll([
          'founderUid', 'founderNickname', 'globalSlowModeSec',
          'wordFilterEnabled', 'chatDisabledGlobally', 'broadcastBanner',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'founderUid', 'founderNickname', 'globalSlowModeSec',
          'wordFilterEnabled', 'chatDisabledGlobally', 'broadcastBanner',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.founderUid)
        && data.founderNickname is string && data.founderNickname.size() >= 2 && data.founderNickname.size() <= 20
        && data.globalSlowModeSec is number && data.globalSlowModeSec >= 0 && data.globalSlowModeSec <= 60
        && data.wordFilterEnabled is bool
        && data.chatDisabledGlobally is bool
        && data.broadcastBanner is string && data.broadcastBanner.size() <= 200
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidUsernameDoc(data, key) {
      return data.keys().hasAll(['usernameKey', 'uid', 'nickname', 'updatedAt'])
        && data.keys().hasOnly(['usernameKey', 'uid', 'nickname', 'updatedAt'])
        && data.usernameKey == key
        && isValidUsernameKey(data.usernameKey)
        && isValidId(data.uid)
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 20
        && isValidTimestamp(data.updatedAt);
    }

    function isValidChallenge(data) {
      return data.keys().hasAll([
          'id', 'creatorUid', 'creatorNickname', 'creatorElo',
          'timeControlId', 'timeControlLabel', 'minutes', 'increment',
          'preferredColor', 'status', 'matchedMatchId', 'opponentUid',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'creatorUid', 'creatorNickname', 'creatorElo',
          'timeControlId', 'timeControlLabel', 'minutes', 'increment',
          'preferredColor', 'status', 'matchedMatchId', 'opponentUid',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.creatorUid)
        && data.creatorNickname is string && data.creatorNickname.size() >= 2 && data.creatorNickname.size() <= 20
        && data.creatorElo is number && data.creatorElo >= 100 && data.creatorElo <= 4000
        && data.timeControlId is string && data.timeControlId.size() >= 1 && data.timeControlId.size() <= 32
        && data.timeControlLabel is string && data.timeControlLabel.size() >= 1 && data.timeControlLabel.size() <= 20
        && data.minutes is number && data.minutes >= 0 && data.minutes <= 180
        && data.increment is number && data.increment >= 0 && data.increment <= 120
        && data.preferredColor in ['random', 'white', 'black']
        && data.status in ['open', 'matched', 'cancelled']
        && data.matchedMatchId is string && data.matchedMatchId.size() <= 128
        && data.opponentUid is string && data.opponentUid.size() <= 128
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidMatch(data) {
      return data.keys().hasAll([
          'id', 'inviteType', 'status',
          'hostUid', 'hostNickname', 'hostElo',
          'guestUid', 'guestNickname', 'guestElo',
          'timeControlId', 'timeControlLabel', 'minutes', 'increment',
          'p1Uid', 'p2Uid', 'p1Faction', 'activePlayer',
          'p1TimeMs', 'p2TimeMs', 'stateVersion', 'turnsPlayed',
          'boardFlat', 'drawPile', 'discardPile',
          'capturedWhitePieces', 'capturedBlackPieces', 'exiledPieces',
          'cardFaceDown', 'phase', 'movesRemaining', 'skipOpponentTurns',
          'wildTeleportPending', 'plus2Remaining', 'plus4Remaining',
          'pendingWildPieceType', 'bannerKey', 'winnerUid', 'winReasonKey', 'eloDelta',
          'lastChainColor', 'lastChainBy', 'isFirstMoveOfTurn', 'moveHistory', 'lastDuelText',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'inviteType', 'status',
          'hostUid', 'hostNickname', 'hostElo',
          'guestUid', 'guestNickname', 'guestElo',
          'timeControlId', 'timeControlLabel', 'minutes', 'increment',
          'p1Uid', 'p2Uid', 'p1Faction', 'activePlayer',
          'p1TimeMs', 'p2TimeMs', 'stateVersion', 'turnsPlayed',
          'boardFlat', 'drawPile', 'discardPile',
          'capturedWhitePieces', 'capturedBlackPieces', 'exiledPieces',
          'enPassantTarget', 'currentCard', 'cardFaceDown',
          'phase', 'movesRemaining', 'skipOpponentTurns',
          'wildTeleportPending', 'plus2Remaining', 'plus4Remaining',
          'pendingWildPieceType', 'pendingPromotion',
          'bannerKey', 'bannerParams',
          'winnerUid', 'winReasonKey', 'eloDelta',
          'lastChainColor', 'lastChainBy', 'isFirstMoveOfTurn', 'moveHistory', 'lastDuelText',
          'joinedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.inviteType in ['lobby', 'magic_link']
        && data.status in ['waiting', 'active', 'finished']
        && isValidId(data.hostUid)
        && data.hostNickname is string && data.hostNickname.size() >= 2 && data.hostNickname.size() <= 20
        && data.hostElo is number && data.hostElo >= 100 && data.hostElo <= 4000
        && data.guestUid is string && data.guestUid.size() <= 128
        && data.guestNickname is string && data.guestNickname.size() <= 20
        && data.guestElo is number && data.guestElo >= 0 && data.guestElo <= 4000
        && data.timeControlId is string && data.timeControlId.size() >= 1 && data.timeControlId.size() <= 32
        && data.timeControlLabel is string && data.timeControlLabel.size() >= 1 && data.timeControlLabel.size() <= 20
        && data.minutes is number && data.minutes >= 0 && data.minutes <= 180
        && data.increment is number && data.increment >= 0 && data.increment <= 120
        && isValidId(data.p1Uid)
        && data.p2Uid is string && data.p2Uid.size() <= 128
        && data.p1Faction in ['white', 'black']
        && data.activePlayer in ['p1', 'p2']
        && data.p1TimeMs is number && data.p1TimeMs >= 0 && data.p1TimeMs <= 10800000
        && data.p2TimeMs is number && data.p2TimeMs >= 0 && data.p2TimeMs <= 10800000
        && data.stateVersion is number && data.stateVersion >= 0
        && data.turnsPlayed is number && data.turnsPlayed >= 1
        && data.boardFlat is list && data.boardFlat.size() == 64
        && data.drawPile is list && data.drawPile.size() <= 150
        && data.discardPile is list && data.discardPile.size() <= 150
        && data.capturedWhitePieces is list && data.capturedWhitePieces.size() <= 32
        && data.capturedBlackPieces is list && data.capturedBlackPieces.size() <= 32
        && data.exiledPieces is list && data.exiledPieces.size() <= 32
        && data.cardFaceDown is bool
        && data.phase is string && data.phase.size() >= 1 && data.phase.size() <= 40
        && data.movesRemaining is number && data.movesRemaining >= 0 && data.movesRemaining <= 20
        && data.skipOpponentTurns is number && data.skipOpponentTurns >= 0 && data.skipOpponentTurns <= 10
        && data.wildTeleportPending is bool
        && data.plus2Remaining is number && data.plus2Remaining >= 0 && data.plus2Remaining <= 4
        && data.plus4Remaining is number && data.plus4Remaining >= 0 && data.plus4Remaining <= 4
        && data.pendingWildPieceType is string && data.pendingWildPieceType.size() <= 16
        && data.bannerKey is string && data.bannerKey.size() <= 80
        && data.winnerUid is string && data.winnerUid.size() <= 128
        && data.winReasonKey is string && data.winReasonKey.size() <= 80
        && data.eloDelta is number && data.eloDelta >= 0 && data.eloDelta <= 200
        && data.lastChainColor in ['', 'red', 'blue', 'green', 'yellow']
        && data.lastChainBy in ['', 'p1', 'p2']
        && data.isFirstMoveOfTurn is bool
        && data.moveHistory is list && data.moveHistory.size() <= 500
        && (data.moveHistory.size() == 0 || data.moveHistory[0] is map)
        && data.lastDuelText is string && data.lastDuelText.size() <= 160
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'id', 'matchId', 'senderUid', 'senderNickname', 'senderRole',
          'text', 'kind', 'deleted', 'deletedBy', 'flagged',
          'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'matchId', 'senderUid', 'senderNickname', 'senderRole',
          'text', 'kind', 'deleted', 'deletedBy', 'flagged',
          'createdAtMs', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.matchId)
        && isValidId(data.senderUid)
        && data.senderNickname is string && data.senderNickname.size() >= 2 && data.senderNickname.size() <= 20
        && data.senderRole in ['user', 'moderator', 'founder']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 300
        && data.kind in ['text', 'system', 'moderated']
        && data.deleted is bool
        && data.deletedBy is string && data.deletedBy.size() <= 128
        && data.flagged is bool
        && data.createdAtMs is number && data.createdAtMs >= 0
        && isValidTimestamp(data.createdAt);
    }

    function isValidReport(data) {
      return data.keys().hasAll([
          'id', 'reporterUid', 'reporterNickname', 'category',
          'targetUid', 'targetNickname', 'matchId', 'messageId',
          'messageExcerpt', 'description', 'status', 'resolutionNote',
          'handledByUid', 'handledByNickname', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'reporterUid', 'reporterNickname', 'category',
          'targetUid', 'targetNickname', 'matchId', 'messageId',
          'messageExcerpt', 'description', 'status', 'resolutionNote',
          'handledByUid', 'handledByNickname', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.reporterUid)
        && data.reporterNickname is string && data.reporterNickname.size() >= 2 && data.reporterNickname.size() <= 20
        && data.category in ['behavior', 'chat', 'bug']
        && data.targetUid is string && data.targetUid.size() <= 128
        && data.targetNickname is string && data.targetNickname.size() <= 40
        && data.matchId is string && data.matchId.size() <= 128
        && data.messageId is string && data.messageId.size() <= 128
        && data.messageExcerpt is string && data.messageExcerpt.size() <= 300
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 500
        && data.status in ['open', 'in_review', 'resolved', 'dismissed']
        && data.resolutionNote is string && data.resolutionNote.size() <= 300
        && data.handledByUid is string && data.handledByUid.size() <= 128
        && data.handledByNickname is string && data.handledByNickname.size() <= 40
        && data.createdAtMs is number && data.createdAtMs >= 0
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidAppeal(data) {
      return data.keys().hasAll([
          'id', 'appellantUid', 'appellantNickname', 'sanctionType',
          'reason', 'status', 'reviewerUid', 'reviewerNickname',
          'reviewerNote', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'appellantUid', 'appellantNickname', 'sanctionType',
          'reason', 'status', 'reviewerUid', 'reviewerNickname',
          'reviewerNote', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.appellantUid)
        && data.appellantNickname is string && data.appellantNickname.size() >= 2 && data.appellantNickname.size() <= 20
        && data.sanctionType in ['ban', 'suspension', 'mute', 'warning', 'other']
        && data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 500
        && data.status in ['pending', 'approved', 'rejected']
        && data.reviewerUid is string && data.reviewerUid.size() <= 128
        && data.reviewerNickname is string && data.reviewerNickname.size() <= 40
        && data.reviewerNote is string && data.reviewerNote.size() <= 300
        && data.createdAtMs is number && data.createdAtMs >= 0
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    function isValidModerationLog(data) {
      return data.keys().hasAll([
          'id', 'action', 'actorUid', 'actorNickname',
          'targetUid', 'targetNickname', 'details', 'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'action', 'actorUid', 'actorNickname',
          'targetUid', 'targetNickname', 'details', 'createdAtMs', 'createdAt'
        ])
        && isValidId(data.id)
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 64
        && isValidId(data.actorUid)
        && data.actorNickname is string && data.actorNickname.size() >= 2 && data.actorNickname.size() <= 20
        && data.targetUid is string && data.targetUid.size() <= 128
        && data.targetNickname is string && data.targetNickname.size() <= 40
        && data.details is string && data.details.size() <= 300
        && data.createdAtMs is number && data.createdAtMs >= 0
        && isValidTimestamp(data.createdAt);
    }

    function isValidMatchRecord(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'mode', 'whiteName', 'blackName',
          'playerFaction', 'result', 'outcome', 'reasonText',
          'timeControlLabel', 'turnsPlayed', 'elapsedSeconds',
          'createdAtMs', 'moves', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'mode', 'whiteName', 'blackName',
          'whiteElo', 'blackElo', 'playerFaction', 'result',
          'outcome', 'reasonText', 'timeControlLabel', 'turnsPlayed',
          'elapsedSeconds', 'eloDelta', 'createdAtMs', 'moves',
          'replayTree', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.mode in ['bot', 'local', 'online']
        && data.whiteName is string && data.whiteName.size() >= 1 && data.whiteName.size() <= 40
        && data.blackName is string && data.blackName.size() >= 1 && data.blackName.size() <= 40
        && (!('whiteElo' in data) || data.whiteElo == null || (data.whiteElo is number && data.whiteElo >= 0 && data.whiteElo <= 4000))
        && (!('blackElo' in data) || data.blackElo == null || (data.blackElo is number && data.blackElo >= 0 && data.blackElo <= 4000))
        && data.playerFaction in ['white', 'black']
        && data.result in ['1-0', '0-1', '1/2-1/2', '*']
        && data.outcome in ['win', 'loss', 'draw']
        && data.reasonText is string && data.reasonText.size() <= 120
        && data.timeControlLabel is string && data.timeControlLabel.size() >= 1 && data.timeControlLabel.size() <= 24
        && data.turnsPlayed is number && data.turnsPlayed >= 1 && data.turnsPlayed <= 2000
        && data.elapsedSeconds is number && data.elapsedSeconds >= 0 && data.elapsedSeconds <= 86400
        && (!('eloDelta' in data) || data.eloDelta == null || (data.eloDelta is number && data.eloDelta >= 0 && data.eloDelta <= 200))
        && data.createdAtMs is number && data.createdAtMs >= 0
        && data.moves is list && data.moves.size() <= 500
        && (data.moves.size() == 0 || data.moves[0] is map)
        && (!('replayTree' in data) || data.replayTree is map)
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    // ---------- /system/{docId} ----------
    match /system/{docId} {
      allow get: if docId == 'moderation';
      allow list: if false;

      allow create: if docId == 'moderation'
        && isValidSystemModeration(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if docId == 'moderation'
        && isValidSystemModeration(incoming())
        && incoming().founderUid == existing().founderUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'globalSlowModeSec', 'wordFilterEnabled', 'chatDisabledGlobally', 'broadcastBanner', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ---------- /usernames/{usernameKey} ----------
    match /usernames/{usernameKey} {
      allow get: if isValidUsernameKey(usernameKey);
      allow list: if false;

      allow create: if isValidUsernameKey(usernameKey)
        && isValidUsernameDoc(incoming(), usernameKey)
        && (usernameKey != 'gatochess89' || incoming().uid == 'lichess_gatochess89')
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/players/$(incoming().uid));

      allow update: if isValidUsernameKey(usernameKey)
        && isValidUsernameDoc(incoming(), usernameKey)
        && (usernameKey != 'gatochess89' || incoming().uid == 'lichess_gatochess89')
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/players/$(incoming().uid));

      allow delete: if isValidUsernameKey(usernameKey)
        && usernameKey != 'gatochess89';
    }

    // ---------- /players/{uid} ----------
    match /players/{uid} {
      allow get: if isValidId(uid);
      allow list: if existing().elo >= 100;

      allow create: if isValidId(uid)
        && isValidPlayer(incoming())
        && incoming().uid == uid
        && incoming().wins == 0
        && incoming().losses == 0
        && (!('banned' in incoming()) || incoming().banned == false)
        && (!('warningsCount' in incoming()) || incoming().warningsCount == 0)
        && (
          (
            isGuaranteedModeratorUid(uid, incoming())
            && 'role' in incoming()
            && incoming().role == 'moderator'
          )
          || (
            !isGuaranteedModeratorUid(uid, incoming())
            && (
              !('role' in incoming())
              || incoming().role == 'user'
              || (
                incoming().role == 'founder'
                && !exists(/databases/$(database)/documents/system/moderation)
              )
            )
          )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(uid)
        && isValidPlayer(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          !isGuaranteedModeratorUid(uid, existing())
          || (
            'role' in incoming()
            && incoming().role in ['moderator', 'founder']
          )
        )
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['elo', 'elos', 'wins', 'losses', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'nickname', 'elo', 'elos', 'authType', 'lichessUsername', 'lichessElo', 'lichessElos', 'updatedAt'
          ])
          || (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nickname', 'elo', 'elos', 'authType', 'lichessUsername', 'lichessElo', 'lichessElos', 'role', 'updatedAt'
            ])
            && isGuaranteedModeratorUid(uid, incoming())
            && 'role' in incoming()
            && incoming().role == 'moderator'
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
            && (!('role' in existing()) || existing().role != 'founder')
            && (!isGuaranteedModeratorUid(uid, existing()) || ('role' in incoming() && incoming().role == 'moderator'))
            && (
              incoming().role in ['user', 'moderator']
              || (incoming().role == 'founder' && !exists(/databases/$(database)/documents/system/moderation))
            )
          )
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'banned', 'suspendedUntilMs', 'chatMuted', 'mutedUntilMs',
            'warningsCount', 'sanctionReason', 'elo', 'elos', 'wins', 'losses',
            'nickname', 'updatedAt'
          ])
        );

      allow delete: if false;

      // ---------- /players/{uid}/matches/{recordId} ----------
      match /matches/{recordId} {
        allow get: if isValidId(uid) && isValidId(recordId)
          && exists(/databases/$(database)/documents/players/$(uid));
        allow list: if isValidId(uid)
          && existing().ownerUid == uid;

        allow create: if isValidId(uid) && isValidId(recordId)
          && exists(/databases/$(database)/documents/players/$(uid))
          && isValidMatchRecord(incoming())
          && incoming().id == recordId
          && incoming().ownerUid == uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(uid) && isValidId(recordId)
          && exists(/databases/$(database)/documents/players/$(uid))
          && isValidMatchRecord(incoming())
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'moves', 'replayTree', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    // ---------- /challenges/{challengeId} ----------
    match /challenges/{challengeId} {
      allow get: if isValidId(challengeId);
      allow list: if existing().status == 'open' || existing().status == 'matched';

      allow create: if isValidId(challengeId)
        && isValidChallenge(incoming())
        && incoming().id == challengeId
        && incoming().status == 'open'
        && incoming().matchedMatchId == ''
        && incoming().opponentUid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(challengeId)
        && isValidChallenge(incoming())
        && existing().status == 'open'
        && incoming().id == existing().id
        && incoming().creatorUid == existing().creatorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Creator or Moderator cancels open challenge
          (
            incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Action: Another player accepts open challenge and atomically creates match
          (
            incoming().status == 'matched'
            && isValidId(incoming().opponentUid)
            && incoming().opponentUid != existing().creatorUid
            && isValidId(incoming().matchedMatchId)
            && existsAfter(/databases/$(database)/documents/matches/$(incoming().matchedMatchId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'opponentUid', 'matchedMatchId', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(challengeId)
        && existing().status == 'open';
    }

    // ---------- /matches/{matchId} ----------
    match /matches/{matchId} {
      allow get: if isValidId(matchId);
      allow list: if false;

      allow create: if isValidId(matchId)
        && isValidMatch(incoming())
        && incoming().id == matchId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().inviteType == 'magic_link'
            && incoming().status == 'waiting'
            && incoming().p1Uid == incoming().hostUid
            && incoming().guestUid == ''
            && incoming().p2Uid == ''
          )
          ||
          (
            incoming().inviteType == 'lobby'
            && incoming().status == 'active'
            && isValidId(incoming().guestUid)
            && incoming().p2Uid == incoming().guestUid
            && incoming().hostUid != incoming().guestUid
            && incoming().p1Uid == incoming().hostUid
          )
        );

      allow update: if isValidId(matchId)
        && isValidMatch(incoming())
        && existing().status != 'finished'
        && incoming().id == existing().id
        && incoming().inviteType == existing().inviteType
        && incoming().hostUid == existing().hostUid
        && incoming().p1Uid == existing().p1Uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().status == 'waiting'
            && existing().inviteType == 'magic_link'
            && isValidId(incoming().guestUid)
            && incoming().guestUid != existing().hostUid
            && incoming().status == 'active'
            && incoming().p2Uid == incoming().guestUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'guestUid', 'guestNickname', 'guestElo',
              'p2Uid', 'updatedAt'
            ])
          )
          ||
          (
            existing().status == 'waiting'
            && incoming().status == 'finished'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'winReasonKey', 'updatedAt'
            ])
          )
          ||
          (
            existing().status == 'active'
            && incoming().guestUid == existing().guestUid
            && incoming().p2Uid == existing().p2Uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'p1Faction', 'activePlayer', 'p1TimeMs', 'p2TimeMs',
              'stateVersion', 'turnsPlayed', 'boardFlat', 'drawPile', 'discardPile',
              'capturedWhitePieces', 'capturedBlackPieces', 'exiledPieces',
              'enPassantTarget', 'currentCard', 'cardFaceDown', 'phase',
              'movesRemaining', 'skipOpponentTurns', 'wildTeleportPending',
              'plus2Remaining', 'plus4Remaining', 'pendingWildPieceType',
              'pendingPromotion', 'bannerKey', 'bannerParams',
              'winnerUid', 'winReasonKey', 'eloDelta',
              'lastChainColor', 'lastChainBy', 'isFirstMoveOfTurn', 'moveHistory', 'lastDuelText',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;

      // ---------- /matches/{matchId}/messages/{messageId} ----------
      match /messages/{messageId} {
        allow get: if isValidId(matchId) && isValidId(messageId)
          && exists(/databases/$(database)/documents/matches/$(matchId));
        allow list: if isValidId(matchId)
          && existing().matchId == matchId;

        allow create: if isValidId(matchId) && isValidId(messageId)
          && exists(/databases/$(database)/documents/matches/$(matchId))
          && isValidChatMessage(incoming())
          && incoming().id == messageId
          && incoming().matchId == matchId
          && incoming().deleted == false
          && incoming().createdAt == request.time;

        allow update: if isValidId(matchId) && isValidId(messageId)
          && exists(/databases/$(database)/documents/matches/$(matchId))
          && isValidChatMessage(incoming())
          && incoming().id == existing().id
          && incoming().matchId == existing().matchId
          && incoming().senderUid == existing().senderUid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'text', 'kind', 'deleted', 'deletedBy', 'flagged'
          ]);

        allow delete: if false;
      }
    }

    // ---------- /reports/{reportId} ----------
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if existing().status in ['open', 'in_review', 'resolved', 'dismissed'];

      allow create: if isValidId(reportId)
        && isValidReport(incoming())
        && incoming().id == reportId
        && incoming().status == 'open'
        && incoming().handledByUid == ''
        && incoming().resolutionNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(reportId)
        && isValidReport(incoming())
        && incoming().id == existing().id
        && incoming().reporterUid == existing().reporterUid
        && incoming().category == existing().category
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'resolutionNote', 'handledByUid', 'handledByNickname', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ---------- /appeals/{appealId} ----------
    match /appeals/{appealId} {
      allow get: if isValidId(appealId);
      allow list: if existing().status in ['pending', 'approved', 'rejected'];

      allow create: if isValidId(appealId)
        && isValidAppeal(incoming())
        && incoming().id == appealId
        && incoming().status == 'pending'
        && incoming().reviewerUid == ''
        && incoming().reviewerNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(appealId)
        && isValidAppeal(incoming())
        && (existing().status == 'pending' || incoming().status == existing().status)
        && incoming().id == existing().id
        && incoming().appellantUid == existing().appellantUid
        && incoming().sanctionType == existing().sanctionType
        && incoming().reason == existing().reason
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewerUid', 'reviewerNickname', 'reviewerNote', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ---------- /moderationLogs/{logId} ----------
    match /moderationLogs/{logId} {
      allow get: if isValidId(logId);
      allow list: if existing().createdAtMs >= 0;

      allow create: if isValidId(logId)
        && isValidModerationLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
